SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/foxtrot
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=changeme
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION=86400000

CALL_JWT_SECRET=change-me-to-a-different-long-random-secret
CALL_JWT_EXPIRATION=60000

# Нужен даже когда собираешь/поднимаешь только backend - docker compose разбирает
# переменные ВСЕХ сервисов из docker-compose.yml разом, в том числе сервиса frontend,
# даже если ты его не трогаешь. Для прода - реальный домен (https://ваш-домен).
NUXT_PUBLIC_API_BASE=http://localhost:8080

MEDIA_SERVICE_BASE_URL=http://localhost:4000
MEDIA_SERVICE_PUBLIC_URL=http://localhost:4000
MEDIA_SERVICE_INTERNAL_SECRET=change-me-to-a-long-random-secret
# Обязателен, даже для локальной разработки - без него звонки/демонстрация экрана не
# заработают вообще. НЕ 127.0.0.1, даже если браузер и media-service - один и тот же хост:
# Firefox (и не только) не собирает loopback как свой локальный ICE-кандидат, у него это
# реальный LAN IP - пара "реальный IP (браузер) <-> 127.0.0.1 (сервер)" физически невалидна,
# ICE проваливается молча (сигнализация продолжает отвечать "ok"). Узнайте реальный IP
# машины в локальной сети через `hostname -I` или `ip route` (обычно 192.168.x.x) и укажите
# его здесь. Для прода - публичный IP сервера.
MEDIASOUP_ANNOUNCED_IP=192.168.1.100
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=49999
APP_WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
PORT=8080

# Only read by docker-compose.yml (for the postgres container itself).
# Keep POSTGRES_PASSWORD equal to SPRING_DATASOURCE_PASSWORD above when running via docker compose.
POSTGRES_DB=foxtrot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Only read by docker-compose.yml (media-service + optional coturn container).
# TURN_HOST is the public DNS name (for example turn.example.com); point it at this server
# and use a coturn certificate that includes that name. With profiles `proxy` + `turn`,
# HAProxy routes turn.* SNI on public TCP/443 to coturn while HTTPS goes to nginx.
# Leave TURN_HOST/SECRET empty to disable TURN. TURN_SECRET must be random and private.
TURN_HOST=
TURN_SECRET=
TURN_REALM=foxtrot.local
# Coturn relay address: set both to the public IP on a directly-addressed host; behind NAT,
# set TURN_EXTERNAL_IP to the public IP and TURN_LISTENING_IP to the local relay interface.
TURN_EXTERNAL_IP=
TURN_LISTENING_IP=
TURN_UDP_PORT=3478
TURN_TLS_PORT=443
TURN_TLS_LISTEN_PORT=5349
TURN_MIN_PORT=50000
TURN_MAX_PORT=59999
TURN_TLS_CERT_FILE=/etc/coturn/certs/fullchain.pem
TURN_TLS_KEY_FILE=/etc/coturn/certs/privkey.pem
STUN_URLS=stun:stun.l.google.com:19302
CALL_SESSION_GRACE_SECONDS=45
CALL_ROOM_IDLE_SECONDS=120
WS_HEARTBEAT_INTERVAL_MS=10000
WS_HEARTBEAT_TIMEOUT_MS=30000

# Только для docker-compose.yml - куда на ХОСТЕ бинд-маунтится папка с загруженными
# картинками (фон чата), чтобы не терять их при пересоздании контейнера. Внутри
# контейнера путь всегда /app/uploads (см. APP_UPLOADS_DIR в самом docker-compose.yml).
UPLOADS_HOST_DIR=./uploads
