# Порт HTTP+WS сервера (внутренний API для Spring Boot и WSS-сигнализация для клиентов)
PORT=4000

# Совпадает с call.jwt.secret в back/.env.example - этим секретом Spring Boot подписывает
# callToken, а media-service его проверяет (см. src/auth/callToken.ts).
CALL_JWT_SECRET=change-me-to-a-different-long-random-secret

# Совпадает с MEDIA_SERVICE_INTERNAL_SECRET в back/.env.example - защищает обе стороны
# внутренней связи: POST/DELETE /rooms (Java -> сюда) и /internal/calls/*/events (отсюда -> Java).
MEDIA_SERVICE_INTERNAL_SECRET=change-me-to-a-long-random-secret

# Куда слать вебхуки о событиях участников (JOINED/LEFT/ROOM_EMPTY).
SPRING_BOOT_INTERNAL_URL=http://localhost:8080

# mediasoup: диапазон UDP/TCP портов для реального медиапотока (см. Foxtrot Calls - Roadmap, §6.6/§7)
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=49999
# Локальный интерфейс, на котором слушаем
MEDIASOUP_LISTEN_IP=0.0.0.0
# Публичный IP сервера - ОБЯЗАТЕЛЕН в проде за NAT (иначе клиенты за пределами локальной
# сети не смогут установить ICE-соединение). ОБЯЗАТЕЛЕН и при запуске через Docker с
# MEDIASOUP_LISTEN_IP=0.0.0.0 - иначе mediasoup буквально отдаёт браузеру "0.0.0.0" как
# адрес ICE-кандидата (невалидно, ICE никогда не подключается - весь звонок молча зависает,
# единственный симптом - iceState остаётся "new" навсегда). Только при запуске media-service
# НЕ в контейнере (просто `npm run dev` на хосте) можно оставить пустым - тогда mediasoup сам
# резолвит реальный IP локального интерфейса. Для докера на одной машине сойдёт 127.0.0.1
# (порты 40000-49999 и так проброшены на хост).
MEDIASOUP_ANNOUNCED_IP=

# Число Worker'ов - по умолчанию равно числу ядер CPU, можно переопределить
MEDIASOUP_NUM_WORKERS=

# TURN (coturn) - нужен клиентам за строгим NAT/файрволом, без него для них звонок не
# соединится. Оставьте оба пустыми в локальной разработке без поднятого coturn - клиент
# просто не получит iceServers и будет работать только на прямом соединении.
# TURN_HOST - доступное браузеру DNS-имя coturn; TURN_SECRET должен совпадать с
# --static-auth-secret у coturn и задаётся только через окружение.
TURN_HOST=
TURN_SECRET=
TURN_UDP_PORT=3478
# Public TLS port; with compose profiles proxy+turn, HAProxy routes turn.* SNI on 443.
TURN_TLS_PORT=443

# Optional comma-separated STUN URLs. TURN credentials are generated per participant.
STUN_URLS=stun:stun.l.google.com:19302

# Signaling session recovery and application heartbeat.
CALL_SESSION_GRACE_SECONDS=45
CALL_ROOM_IDLE_SECONDS=120
WS_HEARTBEAT_INTERVAL_MS=10000
WS_HEARTBEAT_TIMEOUT_MS=30000
