SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/foxtrot
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=changeme
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION=86400000
APP_WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
PORT=8080

# Only read by docker-compose.yml (for the postgres container itself).
# Keep POSTGRES_PASSWORD equal to SPRING_DATASOURCE_PASSWORD above when running via docker compose.
POSTGRES_DB=foxtrot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
